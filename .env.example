# Copie este arquivo para ".env" e cole sua chave real aqui dentro
# NUNCA EM HIPOTÉSE ALGUMA suba o arquivo .env para o GitHub (dados sensíveis)

ANTHROPIC_API_KEY=cole_sua_chave_aqui

# Se for usar a versão gratuita com Google Gemini, preencha esta também:
GEMINI_API_KEY=cole_sua_chave_do_gemini_aqui
